---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Calculadora de Intereses</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-semibold text-slate-900">Calculadora de Intereses</a>
        <nav class="flex gap-4 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-slate-900">Nuevo préstamo</a>
          <a href="/prestamos" class="hover:text-slate-900">Mis préstamos</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
