---
import Layout from "../../layouts/Layout.astro";
import { api, FREQUENCY_LABELS, formatMoney, formatPercent, type LoanSummary } from "../../lib/api";

let loans: LoanSummary[] = [];
let loadError: string | null = null;
try {
  loans = await api.listLoans();
} catch (err) {
  loadError = err instanceof Error ? err.message : "No se pudo conectar con la API.";
}
---

<Layout title="Mis préstamos">
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-14 sm:px-8 sm:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-8">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Panel
        </span>
        <h1 class="mt-4 font-display text-3xl font-semibold tracking-tightest text-ink sm:text-4xl">Mis préstamos</h1>
      </div>
      <a
        href="/"
        class="group inline-flex items-center gap-2 rounded-xl bg-ink px-4 py-2.5 font-display text-sm font-semibold text-paper transition-colors hover:bg-ink/85"
      >
        Nuevo préstamo
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="transition-transform group-hover:rotate-90">
          <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </a>
    </div>

    {loadError && (
      <p class="mt-8 rounded-xl bg-danger-soft px-4 py-3 text-sm font-medium text-danger">{loadError}</p>
    )}

    {!loadError && loans.length === 0 && (
      <div class="mt-8 flex flex-col items-center gap-3 rounded-3xl border border-dashed border-line bg-surface/60 px-6 py-20 text-center">
        <p class="font-display text-lg font-semibold text-ink">Todavía no hay préstamos</p>
        <p class="max-w-sm text-sm text-ink-soft">Crea el primero para ver su cronograma completo y empezar a amortizar cuotas.</p>
        <a href="/" class="mt-3 rounded-xl bg-accent px-5 py-2.5 font-display text-sm font-semibold text-accent-ink transition-transform hover:scale-[1.02]">
          Calcular ahora
        </a>
      </div>
    )}

    {!loadError && loans.length > 0 && (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {loans.map((loan) => (
          <a
            href={`/prestamos/${loan.id}`}
            class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-line bg-surface p-5 transition-all hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-[0_16px_32px_-20px_rgba(19,19,16,0.35)]"
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <p class="font-display text-base font-semibold leading-snug text-ink">{loan.name}</p>
                <span class="shrink-0 rounded-full border border-line bg-paper px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-ink-soft">
                  {loan.rate_type}
                </span>
              </div>
              <p class="mt-3 font-mono text-2xl font-medium tracking-tight text-ink">
                S/&nbsp;{formatMoney(loan.principal)}
              </p>
            </div>

            <div class="mt-6 flex items-center justify-between border-t border-line-soft pt-3 text-xs text-ink-soft">
              <span>{formatPercent(loan.annual_rate)} · {FREQUENCY_LABELS[loan.frequency]}</span>
              <span class="font-mono">{loan.num_installments}c</span>
            </div>

            <svg
              class="pointer-events-none absolute right-4 top-4 text-ink-faint opacity-0 transition-opacity group-hover:opacity-100"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
            >
              <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
